{
  "name": "cardsboard-cli",
  "version": "0.2.0",
  "description": "AI-powered design canvas for React projects - local development tool",
  "main": "dist/index.js",
  "bin": {
    "cardsboard": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:canvas",
    "build:server": "tsup",
    "build:canvas": "vite build",
    "dev": "tsx watch src/cli/index.ts",
    "dev:canvas": "vite",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "design",
    "canvas",
    "ai",
    "components",
    "storybook",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@blocknote/core": "^0.45.0",
    "@blocknote/mantine": "^0.45.0",
    "@blocknote/react": "^0.45.0",
    "@codesandbox/sandpack-client": "^2.18.0",
    "@excalidraw/excalidraw": "^0.18.0",
    "@mantine/core": "^8.3.13",
    "@mantine/hooks": "^8.3.13",
    "@supabase/supabase-js": "^2.93.3",
    "@tiptap/extensions": "^3.18.0",
    "@types/glob": "^8.1.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@xyflow/react": "^12.10.0",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^12.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.3",
    "glob": "^13.0.0",
    "open": "^10.0.0",
    "openai": "^4.28.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.1.0",
    "react-shadow": "^20.4.0",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.16.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^1.3.0"
  }
}
